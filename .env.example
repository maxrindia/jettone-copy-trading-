# ============================================================
# Alice Blue Copy Trading Platform — Environment Variables
# Copy to .env and fill in real values before running.
# NEVER commit .env to version control.
# ============================================================

# --- Domain & Environment ---
NODE_ENV=production
# Must be a real, publicly-resolvable domain pointing at this VPS - Let's
# Encrypt cannot issue a certificate for "localhost" or an IP address.
DOMAIN_NAME=copytrade.example.com
STATIC_VPS_IP=203.0.113.10

# --- TLS / Let's Encrypt (see nginx/init-letsencrypt.sh) ---
# TLS is OPT-IN. nginx and certbot belong to the "tls" Compose profile and are
# NOT started by default (nginx cannot start without a certificate, and this
# stack is normally reached directly on :8080). Once nginx/init-letsencrypt.sh
# has issued a certificate and you have published ports 80/443 on nginx,
# uncomment the next line so `docker compose up -d` and scripts/deploy.sh keep
# nginx/certbot running:
# COMPOSE_PROFILES=tls
# Contact address Let's Encrypt uses for expiry notices, required for issuance.
LETSENCRYPT_EMAIL=you@example.com
# Set to 1 for a first dry run against Let's Encrypt's staging CA (untrusted
# by browsers, but does not count against production rate limits). Unset
# (or 0) once you're ready to request a real, browser-trusted certificate.
LETSENCRYPT_STAGING=0

# --- Database (PostgreSQL 16) ---
POSTGRES_DB=copytrading
POSTGRES_USER=copytrade_admin
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_24
DATABASE_URL=postgresql+asyncpg://copytrade_admin:CHANGE_ME_same_as_POSTGRES_PASSWORD@postgres:5432/copytrading

# --- Redis (Cache & Queue) ---
REDIS_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_24
REDIS_URL=redis://:CHANGE_ME_same_as_REDIS_PASSWORD@redis:6379/0

# --- Next.js & NextAuth ---
NEXTAUTH_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
# Must match how the app is actually reached. Once nginx is serving TLS
# (see nginx/init-letsencrypt.sh), this MUST be https:// - NextAuth uses it
# to build callback/redirect URLs and to decide whether session cookies get
# the Secure flag. Use http://localhost:8080 only for local dev without TLS.
NEXTAUTH_URL=http://localhost:8080

# --- Application Admin Login (single owner) ---
# Generate the hash with: cd frontend && node scripts/hash-password.mjs
# Never store plaintext passwords here.
ADMIN_EMAIL=admin@jettone.local
ADMIN_PASSWORD_HASH=
# TOTP 2FA gate - set true only after TOTP verification is implemented (pre-capital)
TWO_FACTOR_ENABLED=false

# --- Internal Services ---
# FastAPI internal URL - never exposed to public internet
TRADING_ENGINE_URL=http://fastapi:8000
# Shared secret sent by Next.js as X-Internal-Token header on every engine call.
# Generate with: openssl rand -hex 32
# Engine FAILS CLOSED (503) if this is unset.
INTERNAL_API_TOKEN=CHANGE_ME_generate_with_openssl_rand_hex_32

# --- Security & Encryption ---
# REQUIRED. 32-byte urlsafe base64 key used to encrypt broker API credentials at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this key makes previously stored credentials undecryptable.
ALICE_BLUE_ENCRYPTION_KEY=CHANGE_ME_generate_with_the_python_command_above

# --- Trading ---
# Master account capital (INR) used by CAPITAL_PROPORTIONAL / RISK_BASED sizing.
# REQUIRED, must be positive - engine refuses to start otherwise.
MASTER_CAPITAL=100000.00
# Live trading gate. false = observe-only mode: WS feed and risk pipeline run,
# but NO broker orders are ever placed. Only set true after full verification.
ENGINE_LIVE_TRADING_ENABLED=false
# TEMPORARY test switch. true = skip the follower SELL position-safety gate
# (follower SELLs can open naked shorts). Keep false outside controlled tests.
SELL_POSITION_SAFETY_BYPASS=false

# --- Alerting (Telegram) ---
# Unset = alerts are logged only. Create a bot via @BotFather to enable push.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Logging ---
LOG_LEVEL=INFO
